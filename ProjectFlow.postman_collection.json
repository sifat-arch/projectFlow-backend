    {
      "name": "Submissions",
      "item": [
        {
          "name": "Submit Project (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Fullstack ProjectFlow App\",\n  \"frontendRepoUrl\": \"https://github.com/user/projectflow-frontend\",\n  \"backendRepoUrl\": \"https://github.com/user/projectflow-backend\",\n  \"liveLink\": \"https://projectflow.vercel.app\",\n  \"description\": \"An enterprise project submission and review system for students and mentors.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions"]
            }
          }
        },
        {
          "name": "Get My Submissions (Student)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions", "my"]
            }
          }
        },
        {
          "name": "Get Submission Stats (Mentor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mentorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions", "stats"]
            }
          }
        },
        {
          "name": "Get All Submissions with Pagination & Filter (Mentor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mentorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/submissions?page=1&limit=10&status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Update Submission Status (Mentor)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mentorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "submission-uuid-here"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
